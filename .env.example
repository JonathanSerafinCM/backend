# Copia como .env y rellena valores reales

# --- Database ---
POSTGRES_DB=ticketera
POSTGRES_USER=ticketera
POSTGRES_PASSWORD=***supersecret***

# --- App secrets ---
SECRET_KEY=***genera_un_valor_aleatorio_largo***

# --- Blockchain ---
